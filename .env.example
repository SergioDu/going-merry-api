# Porta HTTP do serviço
PORT=3020

# Token compartilhado com o log. Vazio deixa o serviço aberto (deploy em rede privada).
API_TOKEN=

# Rota de cotação da cotacao-api-v2 (POST /api/v2/cotacao/valores/v2).
# Enquanto estiver vazia, o serviço responde com valores SIMULADOS — serve para
# testar o caminho inteiro, nunca para produção.
FREIGHT_API_URL=http://localhost:5105/api/v2/cotacao/valores/v2
# Vai no header X-Api-Key.
FREIGHT_API_KEY=conecta-dev-key

# Quantas cotações podem estar em voo ao mesmo tempo para uma planilha.
FREIGHT_CONCURRENCY=20

# debug | info | warn | error | silent
LOG_LEVEL=info
